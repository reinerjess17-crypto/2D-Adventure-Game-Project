e="p6_b94" target="p6_b91"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_e4l24" value="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="666.6" y="387.0" width="50.0" height="18.0" as="geometry"/></mxCell><mxCell id="p6_e5" value="conversation" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;endArrow=open;endSize=10;endFill=0;startArrow=diamondThin;startFill=1;startSize=14;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;" edge="1" parent="1" source="p6_b95" target="p6_b94"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6_e5l26" value="0..1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="666.6" y="805.0" width="50.0" height="18.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7 Manager and factory"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1341" pageHeight="747" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7_title" value="&lt;b&gt;EntityManager, EntityFactory and support types&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="36.0" y="20.0" width="1269.9" height="40.0" as="geometry"/></mxCell><mxCell id="p7_sub" value="EntityManager owns every entity and runs them all each tick, without caring which kind they are.&lt;br&gt;EntityFactory turns an EntityType name into a real object, so no other class needs to know the constructors." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="36.0" y="62.0" width="1269.9" height="42.0" as="geometry"/></mxCell><mxCell id="p7_b96" value="&lt;b&gt;EntityManager&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#455A64;fontColor=#FFFFFF;strokeColor=#455A64;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="120.0" width="461.9" height="276.0" as="geometry"/></mxCell><mxCell id="p7_b96f" value="&lt;div style=&quot;line-height:14px;&quot;&gt;- entities : List&amp;lt;Entity&amp;gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;- pendingAdd : List&amp;lt;Entity&amp;gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;- player : Player&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;- map : TileMap&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;- occupiedTiles : Set&amp;lt;Long&amp;gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;- knownDeaths : int&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p7_b96"><mxGeometry x="0.0" y="32.0" width="461.9" height="94.0" as="geometry"/></mxCell><mxCell id="p7_b96l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#455A64;" vertex="1" parent="p7_b96"><mxGeometry x="0.0" y="122.0" width="461.9" height="8.0" as="geometry"/></mxCell><mxCell id="p7_b96m" value="&lt;div style=&quot;line-height:14px;&quot;&gt;+ add(entity : Entity) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ spawn(type : EntityType, x, y : double) : Entity&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ scatter(type : EntityType, onTile : byte, chance : double) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ update() : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ draw(g2 : Graphics2D, camX : int, camY : int) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ findInteractableNear(player : Player) : Interactable&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ getEntitiesNear(x, y, radius : double) : List&amp;lt;Entity&amp;gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;- checkContactDamage() : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;- checkPlayerDeath() : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;- removeInactive() : void&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p7_b96"><mxGeometry x="0.0" y="126.0" width="461.9" height="150.0" as="geometry"/></mxCell><mxCell id="p7_b99" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Entity&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;(see Core page)&lt;/i&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=59;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#3D5A80;fontColor=#FFFFFF;strokeColor=#3D5A80;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="691.9" y="140.0" width="130.0" height="59.0" as="geometry"/></mxCell><mxCell id="p7_b100" value="&lt;b&gt;Player&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px;font-weight:normal&quot;&gt;(see Core page)&lt;/i&gt;" style="swimlane;fontStyl