="154.0" as="geometry"/></mxCell><mxCell id="p7_b98f" value="&lt;div style=&quot;line-height:14px;&quot;&gt;SHARP_CACTUS&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;LIFE_BERRY&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;TREE&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;CARABAO&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;WILD_BOAR&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;TIYANAK&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;OLD_TANYO&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p7_b98"><mxGeometry x="0.0" y="46.0" width="130.0" height="108.0" as="geometry"/></mxCell><mxCell id="p7_b101" value="&lt;b&gt;Item&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#455A64;fontColor=#FFFFFF;strokeColor=#455A64;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="931.9" y="496.0" width="157.1" height="94.0" as="geometry"/></mxCell><mxCell id="p7_b101f" value="&lt;div style=&quot;line-height:14px;&quot;&gt;- name : String&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p7_b101"><mxGeometry x="0.0" y="32.0" width="157.1" height="24.0" as="geometry"/></mxCell><mxCell id="p7_b101l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#455A64;" vertex="1" parent="p7_b101"><mxGeometry x="0.0" y="52.0" width="157.1" height="8.0" as="geometry"/></mxCell><mxCell id="p7_b101m" value="&lt;div style=&quot;line-height:14px;&quot;&gt;+ Item(name : String)&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ getName() : String&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p7_b101"><mxGeometry x="0.0" y="56.0" width="157.1" height="38.0" as="geometry"/></mxCell><mxCell id="p7_b102" value="&lt;b&gt;Why a factory?&lt;/b&gt;&lt;br&gt;Callers write spawn(EntityType.TREE, x, y) and never &quot;new Tree(...)&quot;. If a constructor&lt;br&gt;changes, only EntityFactory.create() changes. Adding a new entity type = one enum&lt;br&gt;value + one line in create()." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E9F5F3;strokeColor=#2A9D8F;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="590.0" width="560.0" height="87.0" as="geometry"/></mxCell><mxCell id="p7_b103" value="&lt;b&gt;Item&lt;/b&gt;&lt;br&gt;A placeholder until the inventory exists. Used by Tree&lt;br&gt;(wood), FriendlyAnimal (taming item) and Enemy&lt;br&gt;(drops)." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F0F0F2;strokeColor=#6B7280;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="931.9" y="610.0" width="360.0" height="87.0" as="geometry"/></mxCell><mxCell id="p7_e0" value="entities" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;endArrow=open;endSize=10;endFill=0;startArrow=diamondThin;startFill=0;startSize=14;exitX=1.000;exitY=0.348;entryX=0.000;entryY=0.701;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;" edge="1" parent="1" source="p7_b96" target="p7_b99"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_e0l19" value="0..*" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="649.0" y="163.4" width="50.0" height="18.0" as="geometry"/></mxCell><mxCell id="p7_e1" value="player" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=1.000;exitY=0.594;entryX=0.000;entryY=0.338;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;" edge="1" parent="1" source="p7_b96" target="p7_b100"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_e1l21" value="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="652.3" y="282.5" width="50.0" height="18.0" as="geometry"/></mxCell><mxCell id="p7_e2" value="spawn() calls create()" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.442;exitY=1.000;entryX=0.519;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;" edge="1" parent="1" source="p7_b96" target="p7_b97"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7_e3" value="switch (type)" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=1.000;exitY=0.714;entryX=0.000;entryY=0.325;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p7_b97" target="p7_b98"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="8 Inheritance"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1855" pageHeight="825" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8_title" value="&lt;b&gt;OOP concept 1: Inheritance&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="36.0" y="20.0" width="1783.0" height="40.0" as="geometry"/></mxCell><mxCell id="p8_sub" value="A subclass gets every field and method of its parent for free (written ONCE), then adds only what is new.&lt;br&gt;&quot;extends&quot; builds chains: Tiyanak is a WeakEnemy, which is an Enemy, which is a Creature, which is an Entity." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="36.0" y="62.0" width="1783.0" height="42.0" as="geometry"/></mxCell><mxCell id="p8_b104" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Entity&lt;/i&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#3D5A80;fontColor=#FFFFFF;strokeColor=#3D5A80;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="825.0" y="130.0" width="150.0" height="46.0" as="geometry"/></mxCell><mxCell id="p8_b105" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Creature&lt;/i&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#3D5A80;fontColor=#FFFFFF;strokeColor=#3D5A80;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="825.0" y="242.0" width="150.0" height="46.0" as="geometry"/></mxCell><mxCell id="p8_b106" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Enemy&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;implements DamageSource&lt;/span&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=59;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#B3261E;fontColor=#FFFFFF;strokeColor=#B3261E;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="390.6" y="354.0" width="158.9" height="59.0" as="geometry"/></mxCell><mxCell id="p8_b107" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;WeakEnemy&lt;/i&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#B3261E;fontColor=#FFFFFF;strokeColor=#B3261E;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="395.0" y="466.0" width="150.0" height="46.0" as="geometry"/></mxCell><mxCell id="p8_b108" value="&lt;b&gt;Tiyanak&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#B3261E;fontColor=#FFFFFF;strokeColor=#B3261E;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="395.0" y="578.0" width="150.0" height="32.0" as="geometry"/></mxCell><mxCell id="p8_b109" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Animal&lt;/i&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#B26A00;fontColor=#FFFFFF;strokeColor=#B26A00;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1255.0" y="354.0" width="150.0" height="46.0" as="geometry"/></mxCell><mxCell id="p8_b110" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;FriendlyAnimal&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;implements Interactable&lt;/span&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=59;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#B26A00;fontColor=#FFFFFF;strokeColor=#B26A00;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1255.0" y="466.0" width="150.0" height="59.0" as="geometry"/></mxCell><mxCell id="p8_b111" value="&lt;b&gt;Carabao&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#B26A00;fontColor=#FFFFFF;strokeColor=#B26A00;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1255.0" y="578.0" width="150.0" height="32.0" as="geometry"/></mxCell><mxCell id="p8_b112" value="&lt;b&gt;Entity gives everything&lt;/b&gt;&lt;br&gt;Position (x, y), size, hitbox, overlaps(), distanceTo(), and the contract&lt;br&gt;update() / draw()." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EBEEF2;strokeColor=#3D5A80;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1005.0" y="124.0" width="470.0" height="70.0" as="geometry"/></mxCell><mxCell id="p8_b113" value="&lt;b&gt;Creature adds life and movement&lt;/b&gt;&lt;br&gt;health, takeDamage(), heal(), walking with collision (walk,&lt;br&gt;moveWithCollision) and sprite animation." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EBEEF2;strokeColor=#3D5A80;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1005.0" y="236.0" width="470.0" height="70.0" as="geometry"/></mxCell><mxCell id="p8_b114" value="&lt;b&gt;Enemy adds hostility&lt;/b&gt;&lt;br&gt;attackDamage, performAttack(), canSee(),&lt;br&gt;dropLoot() and the abstract updateAI()." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F7E9E8;strokeColor=#B3261E;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="348.0" width="320.6" height="70.0" as="geometry"/></mxCell><mxCell id="p8_b115" value="&lt;b&gt;WeakEnemy adds a weakness&lt;/b&gt;&lt;br&gt;stun(): a weak enemy can be stunned and then&lt;br&gt;does nothing." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F7E9E8;strokeColor=#B3261E;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="460.0" width="325.0" height="70.0" as="geometry"/></mxCell><mxCell id="p8_b116" value="&lt;b&gt;Tiyanak adds only its own trick&lt;/b&gt;&lt;br&gt;Hide in a bush, leap, latch onto the player and&lt;br&gt;drain life. Everything else is inherited." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F7E9E8;strokeColor=#B3261E;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="572.0" width="325.0" height="70.0" as="geometry"/></mxCell><mxCell id="p8_b117" value="&lt;b&gt;Animal adds a daily routine&lt;/b&gt;&lt;br&gt;The wander loop (IDLE &amp;lt;-&amp;gt; WANDER near its home) and&lt;br&gt;AnimalState." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F7F0E5;strokeColor=#B26A00;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1435.0" y="348.0" width="370.0" height="70.0" as="geometry"/></mxCell><mxCell id="p8_b118" value="&lt;b&gt;FriendlyAnimal adds trust&lt;/b&gt;&lt;br&gt;tryTame(item), isTamed(), and following the player once&lt;br&gt;tamed." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F7F0E5;strokeColor=#B26A00;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1435.0" y="460.0" width="370.0" height="70.0" as="geometry"/></mxCell><mxCell id="p8_b119" value="&lt;b&gt;Carabao adds riding&lt;/b&gt;&lt;br&gt;mount(), dismount(), faster ride speed. Everything else&lt;br&gt;is inherited." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F7F0E5;strokeColor=#B26A00;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1435.0" y="572.0" width="370.0" height="70.0" as="geometry"/></mxCell><mxCell id="p8_b120" value="&lt;b&gt;Written once, used everywhere&lt;/b&gt;&lt;br&gt;takeDamage() exists only in Creature. Player, Carabao, WildBoar, Tiyanak and OldTanyo&lt;br&gt;all use it without copying a single line (reuse, &quot;DRY&quot;)." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EBEEF2;strokeColor=#3D5A80;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="688.0" width="560.0" height="70.0" as="geometry"/></mxCell><mxCell id="p8_b121" value="&lt;b&gt;Chains can be deep&lt;/b&gt;&lt;br&gt;Tiyanak is 4 levels below Entity: Entity &amp;gt; Creature &amp;gt; Enemy &amp;gt; WeakEnemy &amp;gt; Tiyanak.&lt;br&gt;Carabao is also 4 levels: Entity &amp;gt; Creature &amp;gt; Animal &amp;gt; FriendlyAnimal &amp;gt; Carabao&lt;br&gt;(orange arrows)." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#FEF2E5;strokeColor=#F77F00;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="630.0" y="688.0" width="560.0" height="87.0" as="geometry"/></mxCell><mxCell id="p8_b122" value="&lt;b&gt;Other chains in the game&lt;/b&gt;&lt;br&gt;Tree: Entity &amp;gt; Plant &amp;gt; UsefulPlant &amp;gt; Tree. SharpCactus: Entity &amp;gt; Plant &amp;gt; HarmfulPlant &amp;gt;&lt;br&gt;SharpCactus. OldTanyo: Entity &amp;gt; Creature &amp;gt; Villager &amp;gt; OldTanyo." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EAF2EA;strokeColor=#2E7D32;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1220.0" y="688.0" width="560.0" height="70.0" as="geometry"/></mxCell><mxCell id="p8_e0" value="" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p8_b105" target="p8_b104"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_e1" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=2.6;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p8_b106" target="p8_b105"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470.0" y="322.0"/><mxPoint x="900.0" y="322.0"/></Array></mxGeometry></mxCell><mxCell id="p8_e2" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=2.6;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p8_b107" target="p8_b106"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_e3" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=2.6;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p8_b108" target="p8_b107"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_e4" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=2.6;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p8_b109" target="p8_b105"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330.0" y="322.0"/><mxPoint x="900.0" y="322.0"/></Array></mxGeometry></mxCell><mxCell id="p8_e5" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=2.6;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p8_b110" target="p8_b109"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8_e6" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=2.6;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p8_b111" target="p8_b110"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="9 Abstraction"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1734" pageHeight="902" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p9_title" value="&lt;b&gt;OOP concept 2: Abstraction&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="36.0" y="20.0" width="1662.0" height="40.0" as="geometry"/></mxCell><mxCell id="p9_sub" value="An abstract class says WHAT must happen and leaves HOW to its children. Abstract methods have no body (shown in italics).&lt;br&gt;You can never write new Entity() or new Creature(): they exist only to be extended." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="36.0" y="62.0" width="1662.0" height="42.0" as="geometry"/></mxCell><mxCell id="p9_b129" value="&lt;b&gt;Children that implement it&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;strokeWidth=1.3;dashed=1;" vertex="1" parent="1"><mxGeometry x="600.0" y="120.0" width="1084.0" height="111.0" as="geometry"/></mxCell><mxCell id="p9_b137" value="&lt;b&gt;Children that implement it&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;strokeWidth=1.3;dashed=1;" vertex="1" parent="1"><mxGeometry x="600.0" y="286.0" width="1084.0" height="95.0" as="geometry"/></mxCell><mxCell id="p9_b143" value="&lt;b&gt;Children that implement it&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;strokeWidth=1.3;dashed=1;" vertex="1" parent="1"><mxGeometry x="600.0" y="438.0" width="656.0" height="95.0" as="geometry"/></mxCell><mxCell id="p9_b147" value="&lt;b&gt;Children that implement it&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;strokeWidth=1.3;dashed=1;" vertex="1" parent="1"><mxGeometry x="600.0" y="590.0" width="228.0" height="95.0" as="geometry"/></mxCell><mxCell id="p9_b123" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Entity&lt;/i&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#3D5A80;fontColor=#FFFFFF;strokeColor=#3D5A80;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="120.0" width="430.0" height="98.0" as="geometry"/></mxCell><mxCell id="p9_b123m" value="&lt;div style=&quot;line-height:14px;&quot;&gt;&lt;i&gt;+ update(manager : EntityManager) : void&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;&lt;i&gt;+ draw(g2 : Graphics2D, camX : int, camY : int) : void&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#9CA3AF&quot;&gt;…&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p9_b123"><mxGeometry x="0.0" y="46.0" width="430.0" height="52.0" as="geometry"/></mxCell><mxCell id="p9_b124" value="&lt;b&gt;Player&lt;/b&gt;&lt;br&gt;reads the keys, moves, may talk&lt;br&gt;or ride" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5F3F1;strokeColor=#2A9D8F;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="614.0" y="152.0" width="200.0" height="65.0" as="geometry"/></mxCell><mxCell id="p9_b125" value="&lt;b&gt;Plant&lt;/b&gt;&lt;br&gt;counts down its cooldown" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5EFE6;strokeColor=#2E7D32;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="828.0" y="152.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b126" value="&lt;b&gt;Animal&lt;/b&gt;&lt;br&gt;runs updateBehavior()" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5EDE0;strokeColor=#B26A00;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1042.0" y="152.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b127" value="&lt;b&gt;Enemy&lt;/b&gt;&lt;br&gt;runs updateAI()" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5E4E4;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1256.0" y="152.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b128" value="&lt;b&gt;Villager&lt;/b&gt;&lt;br&gt;turns to face the player" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EDE9F2;strokeColor=#6A4C93;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1470.0" y="152.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b130" value="Entity says: &quot;every entity must update itself every tick and draw itself&quot;." style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#4B5563;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40.0" y="226.0" width="490.0" height="20.0" as="geometry"/></mxCell><mxCell id="p9_b131" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Creature&lt;/i&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#3D5A80;fontColor=#FFFFFF;strokeColor=#3D5A80;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="286.0" width="430.0" height="84.0" as="geometry"/></mxCell><mxCell id="p9_b131m" value="&lt;div style=&quot;line-height:14px;&quot;&gt;&lt;i&gt;# onDeath() : void&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#9CA3AF&quot;&gt;…&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p9_b131"><mxGeometry x="0.0" y="46.0" width="430.0" height="38.0" as="geometry"/></mxCell><mxCell id="p9_b132" value="&lt;b&gt;Player&lt;/b&gt;&lt;br&gt;fades out, respawns" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5F3F1;strokeColor=#2A9D8F;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="614.0" y="318.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b133" value="&lt;b&gt;Animal&lt;/b&gt;&lt;br&gt;disappears" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5EDE0;strokeColor=#B26A00;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="828.0" y="318.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b134" value="&lt;b&gt;Enemy&lt;/b&gt;&lt;br&gt;drops loot, disappears" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5E4E4;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1042.0" y="318.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b135" value="&lt;b&gt;Tiyanak&lt;/b&gt;&lt;br&gt;frees the player, then dies" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5E4E4;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1256.0" y="318.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b136" value="&lt;b&gt;Villager&lt;/b&gt;&lt;br&gt;disappears" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EDE9F2;strokeColor=#6A4C93;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1470.0" y="318.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b138" value="Creature says: &quot;every creature must define what happens when its health reaches 0&quot;." style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#4B5563;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40.0" y="378.0" width="490.0" height="20.0" as="geometry"/></mxCell><mxCell id="p9_b139" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Plant&lt;/i&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#2E7D32;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="438.0" width="430.0" height="84.0" as="geometry"/></mxCell><mxCell id="p9_b139m" value="&lt;div style=&quot;line-height:14px;&quot;&gt;&lt;i&gt;# applyEffect(player : Player) : void&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#9CA3AF&quot;&gt;…&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p9_b139"><mxGeometry x="0.0" y="46.0" width="430.0" height="38.0" as="geometry"/></mxCell><mxCell id="p9_b140" value="&lt;b&gt;LifeBerry&lt;/b&gt;&lt;br&gt;heals the player by 20" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5EFE6;strokeColor=#2E7D32;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="614.0" y="470.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b141" value="&lt;b&gt;Tree&lt;/b&gt;&lt;br&gt;gives 3 wood" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5EFE6;strokeColor=#2E7D32;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="828.0" y="470.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b142" value="&lt;b&gt;HarmfulPlant&lt;/b&gt;&lt;br&gt;hurts the player (cactus)" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5EFE6;strokeColor=#2E7D32;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1042.0" y="470.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b144" value="Plant says: &quot;every plant must define its effect when used&quot;." style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#4B5563;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40.0" y="530.0" width="490.0" height="20.0" as="geometry"/></mxCell><mxCell id="p9_b145" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Enemy&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;implements DamageSource&lt;/span&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=59;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#B3261E;fontColor=#FFFFFF;strokeColor=#B3261E;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="590.0" width="430.0" height="97.0" as="geometry"/></mxCell><mxCell id="p9_b145m" value="&lt;div style=&quot;line-height:14px;&quot;&gt;&lt;i&gt;# updateAI(manager : EntityManager) : void&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#9CA3AF&quot;&gt;…&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p9_b145"><mxGeometry x="0.0" y="59.0" width="430.0" height="38.0" as="geometry"/></mxCell><mxCell id="p9_b146" value="&lt;b&gt;Tiyanak&lt;/b&gt;&lt;br&gt;HIDDEN &amp;gt; LEAPING &amp;gt; LATCHED" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5E4E4;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="614.0" y="622.0" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="p9_b148" value="Enemy says: &quot;every enemy must write its own brain&quot;." style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#4B5563;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40.0" y="695.0" width="490.0" height="20.0" as="geometry"/></mxCell><mxCell id="p9_b149" value="&lt;b&gt;Abstract class vs concrete class&lt;/b&gt;&lt;br&gt;Abstract (italic name, «abstract»): Entity, Creature, Plant, UsefulPlant, HarmfulPlant, Animal, FriendlyAnimal,&lt;br&gt;DangerousAnimal, Enemy, WeakEnemy. They cannot be created with new. Concrete classes (Player, Tree,&lt;br&gt;Carabao, WildBoar, Tiyanak, OldTanyo...) can." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EBEEF2;strokeColor=#3D5A80;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="765.0" width="700.0" height="87.0" as="geometry"/></mxCell><mxCell id="p9_b150" value="&lt;b&gt;Why abstract?&lt;/b&gt;&lt;br&gt;The parent can force a rule (every Plant must have an effect) and still let each child&lt;br&gt;decide the details. The rest of the game can rely on the rule." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#FEF2E5;strokeColor=#F77F00;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="770.0" y="765.0" width="560.0" height="70.0" as="geometry"/></mxCell><mxCell id="p9_e0" value="implemented by" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=1.000;exitY=0.566;entryX=0.000;entryY=0.500;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p9_b123" target="p9_b129"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_e1" value="implemented by" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=1.000;exitY=0.565;entryX=0.000;entryY=0.500;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p9_b131" target="p9_b137"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_e2" value="implemented by" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=1.000;exitY=0.565;entryX=0.000;entryY=0.500;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p9_b139" target="p9_b143"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_e3" value="implemented by" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=1.000;exitY=0.490;entryX=0.000;entryY=0.500;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p9_b145" target="p9_b147"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="10 Polymorphism"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1830" pageHeight="805" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p10_title" value="&lt;b&gt;OOP concept 3: Polymorphism&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="36.0" y="20.0" width="1758.0" height="40.0" as="geometry"/></mxCell><mxCell id="p10_sub" value="One call, many behaviors: the same method name does something different depending on the real object behind it.&lt;br&gt;The program decides which version to run while it is RUNNING (dynamic dispatch), not when it is compiled." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="36.0" y="62.0" width="1758.0" height="42.0" as="geometry"/></mxCell><mxCell id="p10_b151" value="A.  One call on the type &quot;Entity&quot;..." style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#1F3A5F;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="110.0" width="290.8" height="23.0" as="geometry"/></mxCell><mxCell id="p10_b152" value="// EntityManager.update()    -    the manager only knows &quot;Entity&quot;&lt;br&gt;for (Entity e : entities) {&lt;br&gt;    e.update(this);      // ...a different update() runs for each real object&lt;br&gt;}" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="433.9" y="140.0" width="528.1" height="74.0" as="geometry"/></mxCell><mxCell id="p10_b153" value="&lt;b&gt;Player&lt;/b&gt;&lt;br&gt;reads the keys, moves, talks,&lt;br&gt;rides" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5F3F1;strokeColor=#2A9D8F;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="284.0" width="206.0" height="65.0" as="geometry"/></mxCell><mxCell id="p10_b154" value="&lt;b&gt;Tree&lt;/b&gt;&lt;br&gt;Plant.update(): counts the&lt;br&gt;cooldown" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5EFE6;strokeColor=#2E7D32;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="262.0" y="284.0" width="206.0" height="65.0" as="geometry"/></mxCell><mxCell id="p10_b155" value="&lt;b&gt;Carabao&lt;/b&gt;&lt;br&gt;wanders, follows when tamed,&lt;br&gt;carries you" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5EDE0;strokeColor=#B26A00;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="484.0" y="284.0" width="206.0" height="65.0" as="geometry"/></mxCell><mxCell id="p10_b156" value="&lt;b&gt;WildBoar&lt;/b&gt;&lt;br&gt;wanders, charges, then rests" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5EDE0;strokeColor=#B26A00;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="706.0" y="284.0" width="206.0" height="49.0" as="geometry"/></mxCell><mxCell id="p10_b157" value="&lt;b&gt;Tiyanak&lt;/b&gt;&lt;br&gt;waits hidden, leaps, drains life" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5E4E4;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="928.0" y="284.0" width="206.0" height="49.0" as="geometry"/></mxCell><mxCell id="p10_b158" value="&lt;b&gt;OldTanyo&lt;/b&gt;&lt;br&gt;stands still and faces you" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EDE9F2;strokeColor=#6A4C93;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1150.0" y="284.0" width="206.0" height="49.0" as="geometry"/></mxCell><mxCell id="p10_b159" value="B.  ...and one call on the type &quot;Interactable&quot; (an interface)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#1F3A5F;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="409.0" width="499.0" height="23.0" as="geometry"/></mxCell><mxCell id="p10_b160" value="// Player.update()   (simplified)&lt;br&gt;Interactable target = manager.findInteractableNear(this);&lt;br&gt;target.interact(this);      // you pressed E: the SAME call..." style="rounded=1;arcSize=12;whiteSpace=nowrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="349.6" y="439.0" width="428.8" height="60.0" as="geometry"/></mxCell><mxCell id="p10_b161" value="&lt;b&gt;LifeBerry&lt;/b&gt;&lt;br&gt;...heals you" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5EFE6;strokeColor=#2E7D32;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="569.0" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="p10_b162" value="&lt;b&gt;Tree&lt;/b&gt;&lt;br&gt;...gives you wood" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5EFE6;strokeColor=#2E7D32;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="306.0" y="569.0" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="p10_b163" value="&lt;b&gt;Carabao&lt;/b&gt;&lt;br&gt;...tames it, then lets you ride" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5EDE0;strokeColor=#B26A00;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="572.0" y="569.0" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="p10_b164" value="&lt;b&gt;OldTanyo&lt;/b&gt;&lt;br&gt;...starts a conversation" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EDE9F2;strokeColor=#6A4C93;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="838.0" y="569.0" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="p10_b165" value="&lt;b&gt;Why it matters&lt;/b&gt;&lt;br&gt;EntityManager never asks &quot;is this a Tree or a Boar?&quot;. Adding a new creature (a Snake, for&lt;br&gt;example) needs NO change in the manager, the loop or the HUD: it just extends the right class&lt;br&gt;and overrides update()." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EBEEF2;strokeColor=#3D5A80;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="668.0" width="620.0" height="87.0" as="geometry"/></mxCell><mxCell id="p10_b166" value="&lt;b&gt;Two kinds in this game&lt;/b&gt;&lt;br&gt;Inheritance polymorphism: Entity.update() and Creature.onDeath(). Interface&lt;br&gt;polymorphism: Interactable.interact(), and Talkable.getDialogue() (a Conversation&lt;br&gt;only knows its Talkable partner)." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#FEF2E5;strokeColor=#F77F00;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="690.0" y="668.0" width="540.0" height="87.0" as="geometry"/></mxCell><mxCell id="p10_b167" value="&lt;b&gt;A small &quot;instanceof&quot; check&lt;/b&gt;&lt;br&gt;findInteractableNear() uses instanceof Interactable only to FIND things that&lt;br&gt;signed the contract, then calls it through the interface." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F0EDF4;strokeColor=#6A4C93;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1260.0" y="668.0" width="520.0" height="70.0" as="geometry"/></mxCell><mxCell id="p10_e0" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=1.8;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p10_b152" target="p10_b153"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="698.0" y="254.0"/><mxPoint x="143.0" y="254.0"/></Array></mxGeometry></mxCell><mxCell id="p10_e1" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=1.8;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p10_b152" target="p10_b154"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="698.0" y="254.0"/><mxPoint x="365.0" y="254.0"/></Array></mxGeometry></mxCell><mxCell id="p10_e2" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=1.8;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p10_b152" target="p10_b155"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="698.0" y="254.0"/><mxPoint x="587.0" y="254.0"/></Array></mxGeometry></mxCell><mxCell id="p10_e3" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=1.8;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p10_b152" target="p10_b156"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="698.0" y="254.0"/><mxPoint x="809.0" y="254.0"/></Array></mxGeometry></mxCell><mxCell id="p10_e4" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=1.8;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p10_b152" target="p10_b157"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="698.0" y="254.0"/><mxPoint x="1031.0" y="254.0"/></Array></mxGeometry></mxCell><mxCell id="p10_e5" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=1.8;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p10_b152" target="p10_b158"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="698.0" y="254.0"/><mxPoint x="1253.0" y="254.0"/></Array></mxGeometry></mxCell><mxCell id="p10_e6" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=1.8;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p10_b160" target="p10_b161"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="564.0" y="539.0"/><mxPoint x="165.0" y="539.0"/></Array></mxGeometry></mxCell><mxCell id="p10_e7" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=1.8;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p10_b160" target="p10_b162"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="564.0" y="539.0"/><mxPoint x="431.0" y="539.0"/></Array></mxGeometry></mxCell><mxCell id="p10_e8" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=1.8;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p10_b160" target="p10_b163"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="564.0" y="539.0"/><mxPoint x="697.0" y="539.0"/></Array></mxGeometry></mxCell><mxCell id="p10_e9" value="" style="html=1;rounded=0;strokeColor=#F77F00;strokeWidth=1.8;endArrow=open;endSize=10;endFill=0;startArrow=none;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p10_b160" target="p10_b164"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="564.0" y="539.0"/><mxPoint x="963.0" y="539.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="11 Interfaces"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1630" pageHeight="595" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p11_title" value="&lt;b&gt;OOP concept 4: Interfaces&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="36.0" y="20.0" width="1558.0" height="40.0" as="geometry"/></mxCell><mxCell id="p11_sub" value="An interface is a pure contract: method names and signatures, no fields. Any class can sign it with &quot;implements&quot;, even unrelated ones.&lt;br&gt;A class has only ONE parent (extends) but can sign MANY interfaces." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="36.0" y="62.0" width="1558.0" height="42.0" as="geometry"/></mxCell><mxCell id="p11_b174" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«interface»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Interactable&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#C9A227;fontColor=#1F2937;strokeColor=#C9A227;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="98.5" y="120.0" width="283.0" height="98.0" as="geometry"/></mxCell><mxCell id="p11_b174m" value="&lt;div style=&quot;line-height:14px;&quot;&gt;+ interact(player : Player) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ canInteract(player : Player) : boolean&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ getPrompt() : String&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p11_b174"><mxGeometry x="0.0" y="46.0" width="283.0" height="52.0" as="geometry"/></mxCell><mxCell id="p11_b175" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«interface»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Talkable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;extends Interactable&lt;/span&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=59;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#C9A227;fontColor=#1F2937;strokeColor=#C9A227;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="497.1" y="120.0" width="375.8" height="111.0" as="geometry"/></mxCell><mxCell id="p11_b175m" value="&lt;div style=&quot;line-height:14px;&quot;&gt;+ getSpeakerName() : String&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ getDialogue() : List&amp;lt;String&amp;gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;&quot;&gt;+ onConversationEnd(player : Player) : void  «default»&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p11_b175"><mxGeometry x="0.0" y="59.0" width="375.8" height="52.0" as="geometry"/></mxCell><mxCell id="p11_b176" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«interface»&lt;/span&gt;&lt;br&gt;&lt;b&gt;DamageSource&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#C9A227;fontColor=#1F2937;strokeColor=#C9A227;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1169.9" y="120.0" width="190.2" height="70.0" as="geometry"/></mxCell><mxCell id="p11_b176m" value="&lt;div style=&quot;line-height:14px;&quot;&gt;+ getContactDamage() : int&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p11_b176"><mxGeometry x="0.0" y="46.0" width="190.2" height="24.0" as="geometry"/></mxCell><mxCell id="p11_b168" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;UsefulPlant&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;implements Interactable&lt;/span&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=59;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#2E7D32;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="341.0" width="170.0" height="59.0" as="geometry"/></mxCell><mxCell id="p11_b169" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;FriendlyAnimal&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;implements Interactable&lt;/span&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=59;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#B26A00;fontColor=#FFFFFF;strokeColor=#B26A00;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="270.0" y="341.0" width="170.0" height="59.0" as="geometry"/></mxCell><mxCell id="p11_b170" value="&lt;b&gt;Villager&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;implements Talkable&lt;/span&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=45;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#6A4C93;fontColor=#FFFFFF;strokeColor=#6A4C93;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="600.0" y="341.0" width="170.0" height="45.0" as="geometry"/></mxCell><mxCell id="p11_b171" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;HarmfulPlant&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;implements DamageSource&lt;/span&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=59;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#2E7D32;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="890.0" y="341.0" width="170.0" height="59.0" as="geometry"/></mxCell><mxCell id="p11_b172" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;DangerousAnimal&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;implements DamageSource&lt;/span&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=59;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#B26A00;fontColor=#FFFFFF;strokeColor=#B26A00;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1180.0" y="341.0" width="170.0" height="59.0" as="geometry"/></mxCell><mxCell id="p11_b173" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Enemy&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;implements DamageSource&lt;/span&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=59;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#B3261E;fontColor=#FFFFFF;strokeColor=#B3261E;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1410.0" y="341.0" width="170.0" height="59.0" as="geometry"/></mxCell><mxCell id="p11_b177" value="&lt;b&gt;A contract, not a parent&lt;/b&gt;&lt;br&gt;Interactable only says WHAT (interact, canInteract, getPrompt). A berry, a&lt;br&gt;tree, a carabao and a villager do it in completely different ways, and they&lt;br&gt;share no common parent except Entity." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F9F5E9;strokeColor=#C9A227;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="441.0" width="500.0" height="87.0" as="geometry"/></mxCell><mxCell id="p11_b178" value="&lt;b&gt;One parent, many interfaces&lt;/b&gt;&lt;br&gt;Tiyanak is a Creature (inheritance) and a DamageSource (interface). Carabao&lt;br&gt;is an Animal and Interactable. Java does not allow two parent classes, but&lt;br&gt;allows many interfaces." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#FEF2E5;strokeColor=#F77F00;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="560.0" y="441.0" width="500.0" height="87.0" as="geometry"/></mxCell><mxCell id="p11_b179" value="&lt;b&gt;Interfaces can extend interfaces&lt;/b&gt;&lt;br&gt;Talkable extends Interactable: talking starts with E, like picking a berry. So&lt;br&gt;everything Talkable is also Interactable. Talkable also has a default method&lt;br&gt;(onConversationEnd) with a body, so classes that do not care need not write&lt;br&gt;it." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F0EDF4;strokeColor=#6A4C93;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1080.0" y="441.0" width="500.0" height="104.0" as="geometry"/></mxCell><mxCell id="p11_e0" value="" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.000;exitY=0.360;entryX=1.000;entryY=0.408;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p11_b175" target="p11_b174"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_e1" value="" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p11_b168" target="p11_b174"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125.0" y="258.0"/><mxPoint x="240.0" y="258.0"/></Array></mxGeometry></mxCell><mxCell id="p11_e2" value="" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p11_b169" target="p11_b174"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355.0" y="258.0"/><mxPoint x="240.0" y="258.0"/></Array></mxGeometry></mxCell><mxCell id="p11_e3" value="" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p11_b170" target="p11_b175"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_e4" value="" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p11_b171" target="p11_b176"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975.0" y="230.0"/><mxPoint x="1265.0" y="230.0"/></Array></mxGeometry></mxCell><mxCell id="p11_e5" value="" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p11_b172" target="p11_b176"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11_e6" value="" style="html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;exitPerimeter=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="p11_b173" target="p11_b176"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1495.0" y="230.0"/><mxPoint x="1265.0" y="230.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="12 Encapsulation"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1228" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p12_title" value="&lt;b&gt;OOP concept 5: Encapsulation&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="36.0" y="20.0" width="1156.6" height="40.0" as="geometry"/></mxCell><mxCell id="p12_sub" value="Hide the data, expose a controlled door. Fields are protected or private; other classes change them only through methods that enforce the rules.&lt;br&gt;Access modifiers shown in the diagram:  + public   # protected   - private   ~ package-private (no modifier)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="36.0" y="62.0" width="1156.6" height="42.0" as="geometry"/></mxCell><mxCell id="p12_b180" value="+  public: anyone" style="rounded=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;fontColor=#15803D;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="110.0" width="145.8" height="24.0" as="geometry"/></mxCell><mxCell id="p12_b181" value="#  protected: class + children + package" style="rounded=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;fontColor=#B45309;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="199.8" y="110.0" width="303.7" height="24.0" as="geometry"/></mxCell><mxCell id="p12_b182" value="-  private: this class only" style="rounded=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;fontColor=#B91C1C;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="517.5" y="110.0" width="194.9" height="24.0" as="geometry"/></mxCell><mxCell id="p12_b183" value="~  package-private: only the entity package" style="rounded=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontColor=#1D4ED8;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="726.5" y="110.0" width="325.8" height="24.0" as="geometry"/></mxCell><mxCell id="p12_b184" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Creature&lt;/i&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#3D5A80;fontColor=#FFFFFF;strokeColor=#3D5A80;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="154.0" width="448.6" height="402.0" as="geometry"/></mxCell><mxCell id="p12_b184f" value="&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# health, maxHealth : int&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# speed : double&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# facing : Direction&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# invulnerableTicks : int&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# sprites : SpriteSet&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# moving : boolean&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# animTimer, frameIndex : int&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# walkTicksPerFrame : int&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p12_b184"><mxGeometry x="0.0" y="46.0" width="448.6" height="122.0" as="geometry"/></mxCell><mxCell id="p12_b184l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#3D5A80;" vertex="1" parent="p12_b184"><mxGeometry x="0.0" y="164.0" width="448.6" height="8.0" as="geometry"/></mxCell><mxCell id="p12_b184m" value="&lt;div style=&quot;line-height:14px;background-color:#FFF1A8;color:#15803D;&quot;&gt;+ takeDamage(amount : int) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;background-color:#FFF1A8;color:#15803D;&quot;&gt;+ drainHealth(amount : int) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;background-color:#FFF1A8;color:#15803D;&quot;&gt;+ heal(amount : int) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#15803D;&quot;&gt;+ isAlive() : boolean&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;&lt;i&gt;# onDeath() : void&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# tickTimers() : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# updateAnimation(isMoving : boolean) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# drawSprite(g2 : Graphics2D, camX : int, camY : int) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# drawSprite(g2, camX, camY, alpha : float) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# drawSprite(g2, camX, camY, alpha : float, offsetY : int) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# walk(dirX, dirY, moveSpeed : double, manager) : boolean&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B45309;&quot;&gt;# moveWithCollision(dx, dy : double, manager) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B91C1C;&quot;&gt;- collides(newX, newY : double, manager) : boolean&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B91C1C;&quot;&gt;- hitsSolidEntity(newX, newY : double, manager) : boolean&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#15803D;&quot;&gt;+ getHealth() : int&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#15803D;&quot;&gt;+ getFacing() : Direction&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p12_b184"><mxGeometry x="0.0" y="168.0" width="448.6" height="234.0" as="geometry"/></mxCell><mxCell id="p12_b185" value="&lt;b&gt;Player&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#2A9D8F;fontColor=#FFFFFF;strokeColor=#2A9D8F;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="592.0" width="322.8" height="178.0" as="geometry"/></mxCell><mxCell id="p12_b185f" value="&lt;div style=&quot;line-height:14px;color:#B91C1C;&quot;&gt;- mount : Carabao&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B91C1C;&quot;&gt;- grabber : Tiyanak&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#B91C1C;&quot;&gt;- conversation : Conversation&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p12_b185"><mxGeometry x="0.0" y="32.0" width="322.8" height="52.0" as="geometry"/></mxCell><mxCell id="p12_b185l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#2A9D8F;" vertex="1" parent="p12_b185"><mxGeometry x="0.0" y="80.0" width="322.8" height="8.0" as="geometry"/></mxCell><mxCell id="p12_b185m" value="&lt;div style=&quot;line-height:14px;color:#1D4ED8;&quot;&gt;~ startRiding(carabao : Carabao) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#1D4ED8;&quot;&gt;~ stopRiding() : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#1D4ED8;&quot;&gt;~ startGrab(enemy : Tiyanak) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#1D4ED8;&quot;&gt;~ endGrab() : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#1D4ED8;&quot;&gt;~ startConversation(partner : Talkable) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#9CA3AF&quot;&gt;…&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p12_b185"><mxGeometry x="0.0" y="84.0" width="322.8" height="94.0" as="geometry"/></mxCell><mxCell id="p12_b186" value="&lt;b&gt;# protected: health, maxHealth, speed, facing&lt;/b&gt;&lt;br&gt;Visible to subclasses (and to the entity package) but hidden from the rest of the game: Hud,&lt;br&gt;GamePanel and GameEngine cannot write creature.health = 0. By design every change goes through&lt;br&gt;takeDamage / drainHealth / heal (highlighted), so the rules always apply: never below 0, never above&lt;br&gt;the maximum, and the protection timer." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F7EDE6;strokeColor=#B45309;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="538.6" y="154.0" width="640.0" height="104.0" as="geometry"/></mxCell><mxCell id="p12_b187" value="&lt;b&gt;+ public: the controlled doors&lt;/b&gt;&lt;br&gt;takeDamage(), heal(), isAlive(), getHealth() are the only way in. There is no setHealth(). Getters give&lt;br&gt;read-only access." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E7F2EB;strokeColor=#15803D;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="538.6" y="274.0" width="640.0" height="70.0" as="geometry"/></mxCell><mxCell id="p12_b188" value="&lt;b&gt;- private: collides(), hitsSolidEntity()&lt;/b&gt;&lt;br&gt;Only Creature needs the collision details. Children call moveWithCollision() and cannot misuse the&lt;br&gt;internals." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F8E8E8;strokeColor=#B91C1C;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="538.6" y="360.0" width="640.0" height="70.0" as="geometry"/></mxCell><mxCell id="p12_b189" value="&lt;b&gt;~ package-private: startRiding(), startGrab(), endGrab()...&lt;/b&gt;&lt;br&gt;No modifier means only classes of the entity package can call them (see the Player box). Player,&lt;br&gt;Carabao and Tiyanak cooperate, but the rest of the game cannot touch them. Carabao.followRider()&lt;br&gt;and Tiyanak.release() work the same way." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E8EDFB;strokeColor=#1D4ED8;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="538.6" y="446.0" width="640.0" height="87.0" as="geometry"/></mxCell><mxCell id="p12_b190" value="&lt;b&gt;final fields and private constructors&lt;/b&gt;&lt;br&gt;final fields (Plant.cooldownTicks, Villager.name, SpriteSet.walkFrames) cannot change after creation.&lt;br&gt;SpriteSet has a PRIVATE constructor, so you must use SpriteSet.load(...). EntityFactory has a private&lt;br&gt;constructor too: it is only a toolbox of static methods." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F0F0F2;strokeColor=#6B7280;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="538.6" y="549.0" width="640.0" height="87.0" as="geometry"/></mxCell><mxCell id="p12_b191" value="&lt;b&gt;Why it matters&lt;/b&gt;&lt;br&gt;If the rest of the game could set health directly, a bug in the HUD or the engine could heal the player&lt;br&gt;to 1000 or kill it without the death sequence. With encapsulation the rules live in ONE place&lt;br&gt;(Creature) and are the only road in." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#FEF2E5;strokeColor=#F77F00;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="538.6" y="652.0" width="640.0" height="87.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="13 Overloading and overriding"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1658" pageHeight="724" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p13_title" value="&lt;b&gt;OOP concept 6: Overloading and overriding&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="36.0" y="20.0" width="1586.6" height="40.0" as="geometry"/></mxCell><mxCell id="p13_sub" value="Overloading = same name, DIFFERENT parameters, same class (the compiler picks by the arguments).&lt;br&gt;Overriding = same name AND same parameters, in a SUBCLASS (a child replaces what it inherited)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="36.0" y="62.0" width="1586.6" height="42.0" as="geometry"/></mxCell><mxCell id="p13_b192" value="Overloading" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#1F3A5F;fontSize=18;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="108.0" width="127.5" height="26.0" as="geometry"/></mxCell><mxCell id="p13_b193" value="&lt;span style=&quot;font-size:10px;font-weight:normal&quot;&gt;«abstract»&lt;/span&gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;Creature&lt;/i&gt;&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#3D5A80;fontColor=#FFFFFF;strokeColor=#3D5A80;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="144.0" width="448.6" height="112.0" as="geometry"/></mxCell><mxCell id="p13_b193m" value="&lt;div style=&quot;line-height:14px;background-color:#FFF1A8;&quot;&gt;# drawSprite(g2 : Graphics2D, camX : int, camY : int) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;background-color:#FFF1A8;&quot;&gt;# drawSprite(g2, camX, camY, alpha : float) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;background-color:#FFF1A8;&quot;&gt;# drawSprite(g2, camX, camY, alpha : float, offsetY : int) : void&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#9CA3AF&quot;&gt;…&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p13_b193"><mxGeometry x="0.0" y="46.0" width="448.6" height="66.0" as="geometry"/></mxCell><mxCell id="p13_b194" value="&lt;b&gt;Tree&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#2E7D32;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="278.0" width="330.0" height="84.0" as="geometry"/></mxCell><mxCell id="p13_b194m" value="&lt;div style=&quot;line-height:14px;background-color:#FFF1A8;&quot;&gt;+ Tree(x, y : double)&lt;/div&gt;&lt;div style=&quot;line-height:14px;background-color:#FFF1A8;&quot;&gt;+ Tree(x, y : double, variant : int)&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#9CA3AF&quot;&gt;…&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p13_b194"><mxGeometry x="0.0" y="32.0" width="330.0" height="52.0" as="geometry"/></mxCell><mxCell id="p13_b195" value="&lt;b&gt;SharpCactus&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#2E7D32;swimlaneFillColor=#ffffff;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="384.0" width="330.0" height="84.0" as="geometry"/></mxCell><mxCell id="p13_b195m" value="&lt;div style=&quot;line-height:14px;background-color:#FFF1A8;&quot;&gt;+ SharpCactus(x, y : double)&lt;/div&gt;&lt;div style=&quot;line-height:14px;background-color:#FFF1A8;&quot;&gt;+ SharpCactus(x, y : double, variant : int)&lt;/div&gt;&lt;div style=&quot;line-height:14px;color:#9CA3AF&quot;&gt;…&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="p13_b195"><mxGeometry x="0.0" y="32.0" width="330.0" height="52.0" as="geometry"/></mxCell><mxCell id="p13_b196" value="public Tree(double x, double y) {&lt;br&gt;    this(x, y, (int) (Math.random() * VARIANT_COUNT));&lt;br&gt;}   // the short version calls the longer one" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="490.0" width="375.8" height="60.0" as="geometry"/></mxCell><mxCell id="p13_b197" value="&lt;b&gt;How the compiler chooses&lt;/b&gt;&lt;br&gt;drawSprite(g2, camX, camY) is the simple call. The longer&lt;br&gt;versions add alpha (transparency for the dying player) and&lt;br&gt;offsetY (the rider sits higher on the carabao). Tree(x, y) picks&lt;br&gt;a random look; Tree(x, y, variant) picks a chosen one." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#FEF2E5;strokeColor=#F77F00;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40.0" y="568.0" width="400.0" height="104.0" as="geometry"/></mxCell><mxCell id="p13_b198" value="Overriding" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#1F3A5F;fontSize=18;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="558.6" y="108.0" width="111.9" height="26.0" as="geometry"/></mxCell><mxCell id="p13_b199" value="Method" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#1F3A5F;strokeColor=#D1D5DB;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="558.6" y="144.0" width="175.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b200" value="Declared in" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#1F3A5F;strokeColor=#D1D5DB;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="144.0" width="215.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b201" value="Overridden in" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#1F3A5F;strokeColor=#D1D5DB;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="948.6" y="144.0" width="330.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b202" value="What changes" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#1F3A5F;strokeColor=#D1D5DB;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1278.6" y="144.0" width="330.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b203" value="update(manager)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="558.6" y="172.0" width="175.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b204" value="Entity (abstract)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="172.0" width="215.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b205" value="Player, Plant, Animal, Enemy, WeakEnemy, Villager" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="948.6" y="172.0" width="330.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b206" value="each kind of entity does its own thing every tick" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1278.6" y="172.0" width="330.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b207" value="takeDamage(amount)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="558.6" y="200.0" width="175.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b208" value="Creature" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="200.0" width="215.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b209" value="Player, Tiyanak" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="948.6" y="200.0" width="330.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b210" value="Player adds 30 ticks of protection after&lt;br&gt;super.takeDamage(); a hidden Tiyanak ignores damage" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1278.6" y="200.0" width="330.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b211" value="onDeath()" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="558.6" y="244.0" width="175.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b212" value="Creature (abstract)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="244.0" width="215.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b213" value="Player, Animal, Enemy, Villager, Tiyanak" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="948.6" y="244.0" width="330.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b214" value="fade and respawn / disappear / drop loot / free the victim&lt;br&gt;first" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1278.6" y="244.0" width="330.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b215" value="updateBehavior(manager)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="558.6" y="288.0" width="175.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b216" value="Animal" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="288.0" width="215.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b217" value="FriendlyAnimal, DangerousAnimal, Carabao, WildBoar" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="948.6" y="288.0" width="330.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b218" value="wander becomes follow, chase, &quot;carried by rider&quot; or &quot;too&lt;br&gt;tired&quot;" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1278.6" y="288.0" width="330.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b219" value="chaseTarget(target,&lt;br&gt;manager)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="558.6" y="332.0" width="175.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b220" value="DangerousAnimal" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="332.0" width="215.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b221" value="WildBoar" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="948.6" y="332.0" width="330.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b222" value="the boar accelerates like a real charge" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1278.6" y="332.0" width="330.0" height="44.0" as="geometry"/></mxCell><mxCell id="p13_b223" value="interact(player)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="558.6" y="376.0" width="175.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b224" value="Interactable (interface)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="376.0" width="215.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b225" value="UsefulPlant, FriendlyAnimal, Villager, Carabao, OldTanyo" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="948.6" y="376.0" width="330.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b226" value="pick / tame / talk / ride or dismount" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1278.6" y="376.0" width="330.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b227" value="getDialogue()" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="558.6" y="404.0" width="175.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b228" value="Villager" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="404.0" width="215.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b229" value="OldTanyo" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="948.6" y="404.0" width="330.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b230" value="his lines depend on the quest stage" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1278.6" y="404.0" width="330.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b231" value="getSortY()" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="558.6" y="432.0" width="175.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b232" value="Entity" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="733.6" y="432.0" width="215.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b233" value="Tiyanak" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="948.6" y="432.0" width="330.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b234" value="drawn in FRONT of the player while latched" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1278.6" y="432.0" width="330.0" height="28.0" as="geometry"/></mxCell><mxCell id="p13_b235" value="// Player.takeDamage(): adds to the inherited behavior&lt;br&gt;@Override&lt;br&gt;public void takeDamage(int amount) {&lt;br&gt;    super.takeDamage(amount);       // Creature does the real work&lt;br&gt;    if (health &amp;lt; healthBefore &amp;amp;&amp;amp; isAlive()) invulnerableTicks = HIT_PROTECTION_TICKS;&lt;br&gt;}" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="558.6" y="484.0" width="581.1" height="102.0" as="geometry"/></mxCell><mxCell id="p13_b236" value="// Tiyanak.onDeath(): its own step, then the parent&#x27;s version&lt;br&gt;@Override&lt;br&gt;protected void onDeath() {&lt;br&gt;    if (victim != null) victim.endGrab();&lt;br&gt;    super.onDeath();          // Enemy: drop loot and disappear&lt;br&gt;}" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1163.8" y="484.0" width="435.4" height="102.0" as="geometry"/></mxCell><mxCell id="p13_b237" value="&lt;b&gt;@Override and super&lt;/b&gt;&lt;br&gt;@Override makes the compiler check that you really replace an inherited method (a typo becomes an error, not a silent bug). super.method() runs the parent&#x27;s version,&lt;br&gt;so a child can ADD to the behavior instead of rewriting it." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#FEF2E5;strokeColor=#F77F00;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="558.6" y="604.0" width="1040.5" height="70.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="14 Design patterns"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p14_title" value="&lt;b&gt;OOP concept 7: Design patterns used in the entity system&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="36.0" y="20.0" width="1878.0" height="40.0" as="geometry"/></mxCell><mxCell id="p14_sub" value="Design patterns are proven solutions to common problems. Six of them appear in this code base." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="36.0" y="62.0" width="1878.0" height="24.0" as="geometry"/></mxCell><mxCell id="p14_b238" value="" style="rounded=1;arcSize=30;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;strokeWidth=1.3;dashed=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="100.0" width="600.0" height="400.0" as="geometry"/></mxCell><mxCell id="p14_b247" value="" style="rounded=1;arcSize=30;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;strokeWidth=1.3;dashed=1;" vertex="1" parent="1"><mxGeometry x="670.0" y="100.0" width="600.0" height="400.0" as="geometry"/></mxCell><mxCell id="p14_b255" value="" style="rounded=1;arcSize=30;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;strokeWidth=1.3;dashed=1;" vertex="1" parent="1"><mxGeometry x="1300.0" y="100.0" width="600.0" height="400.0" as="geometry"/></mxCell><mxCell id="p14_b265" value="" style="rounded=1;arcSize=30;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;strokeWidth=1.3;dashed=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="530.0" width="600.0" height="400.0" as="geometry"/></mxCell><mxCell id="p14_b272" value="" style="rounded=1;arcSize=30;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;strokeWidth=1.3;dashed=1;" vertex="1" parent="1"><mxGeometry x="670.0" y="530.0" width="600.0" height="400.0" as="geometry"/></mxCell><mxCell id="p14_b280" value="" style="rounded=1;arcSize=30;whiteSpace=nowrap;html=1;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;strokeWidth=1.3;dashed=1;" vertex="1" parent="1"><mxGeometry x="1300.0" y="530.0" width="600.0" height="400.0" as="geometry"/></mxCell><mxCell id="p14_b239" value="1.  Factory (simple factory)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#1F3A5F;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="54.0" y="110.0" width="233.7" height="23.0" as="geometry"/></mxCell><mxCell id="p14_b240" value="EntityManager.spawn &amp;gt; EntityFactory.create" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#6B7280;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="54.0" y="134.0" width="247.6" height="19.0" as="geometry"/></mxCell><mxCell id="p14_b241" value="EntityManager.spawn(type, x, y)" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E8EBEC;strokeColor=#455A64;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="60.0" y="170.0" width="270.0" height="40.0" as="geometry"/></mxCell><mxCell id="p14_b242" value="EntityFactory.create(type, x, y)" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E8EBEC;strokeColor=#455A64;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="270.0" width="270.0" height="40.0" as="geometry"/></mxCell><mxCell id="p14_b243" value="new Tree(x, y)" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5EFE6;strokeColor=#2E7D32;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="430.0" y="166.0" width="180.0" height="40.0" as="geometry"/></mxCell><mxCell id="p14_b244" value="new Carabao(x, y)" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5EDE0;strokeColor=#B26A00;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="430.0" y="228.0" width="180.0" height="40.0" as="geometry"/></mxCell><mxCell id="p14_b245" value="new Tiyanak(x, y)" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5E4E4;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="430.0" y="290.0" width="180.0" height="40.0" as="geometry"/></mxCell><mxCell id="p14_b246" value="&lt;b&gt;Benefit&lt;/b&gt;&lt;br&gt;Callers know only the EntityType name. Adding a new entity = one enum value + one line in&lt;br&gt;create()." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E9F5F3;strokeColor=#2A9D8F;fontColor=#111827;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="60.0" y="350.0" width="560.0" height="67.0" as="geometry"/></mxCell><mxCell id="p14_b248" value="2.  State (enum state machine)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#1F3A5F;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="684.0" y="110.0" width="267.4" height="23.0" as="geometry"/></mxCell><mxCell id="p14_b249" value="TiyanakState (and AnimalState, EnemyState, PlayerState)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#6B7280;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="684.0" y="134.0" width="323.7" height="19.0" as="geometry"/></mxCell><mxCell id="p14_b250" value="HIDDEN" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5E4E4;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="685.0" y="200.0" width="130.0" height="46.0" as="geometry"/></mxCell><mxCell id="p14_b251" value="LEAPING" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5E4E4;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="885.0" y="200.0" width="130.0" height="46.0" as="geometry"/></mxCell><mxCell id="p14_b252" value="LATCHED" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5E4E4;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1085.0" y="200.0" width="130.0" height="46.0" as="geometry"/></mxCell><mxCell id="p14_b253" value="dies (removed)" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1120.0" y="332.0" width="130.0" height="38.0" as="geometry"/></mxCell><mxCell id="p14_b254" value="&lt;b&gt;Benefit&lt;/b&gt;&lt;br&gt;The object behaves differently depending on its state, and each state is a clear named value (an&lt;br&gt;enum), not a pile of booleans." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F7E9E8;strokeColor=#B3261E;fontColor=#111827;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="690.0" y="400.0" width="560.0" height="67.0" as="geometry"/></mxCell><mxCell id="p14_b256" value="3.  Template Method" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#1F3A5F;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1314.0" y="110.0" width="177.2" height="23.0" as="geometry"/></mxCell><mxCell id="p14_b257" value="the parent fixes the steps, the child fills one step" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#6B7280;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1314.0" y="134.0" width="273.5" height="19.0" as="geometry"/></mxCell><mxCell id="p14_b258" value="Enemy.update()&lt;br&gt;    calls updateAI()   &amp;lt;- hook" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E7EBEF;strokeColor=#3D5A80;fontColor=#1F2937;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1315.0" y="170.0" width="250.0" height="54.0" as="geometry"/></mxCell><mxCell id="p14_b259" value="Tiyanak: hide, leap, latch" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5E4E4;strokeColor=#B3261E;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1655.0" y="174.0" width="230.0" height="46.0" as="geometry"/></mxCell><mxCell id="p14_b260" value="Animal.update()&lt;br&gt;    calls updateBehavior()   &amp;lt;- hook" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E7EBEF;strokeColor=#3D5A80;fontColor=#1F2937;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1315.0" y="262.0" width="250.0" height="54.0" as="geometry"/></mxCell><mxCell id="p14_b261" value="WildBoar: chase, charge, rest" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5EDE0;strokeColor=#B26A00;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1655.0" y="266.0" width="230.0" height="46.0" as="geometry"/></mxCell><mxCell id="p14_b262" value="Plant.use()&lt;br&gt;    calls applyEffect()   &amp;lt;- hook" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E7EBEF;strokeColor=#3D5A80;fontColor=#1F2937;fontSize=11;fontFamily=Courier New;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1315.0" y="354.0" width="250.0" height="54.0" as="geometry"/></mxCell><mxCell id="p14_b263" value="LifeBerry heals / Tree gives wood" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5EFE6;strokeColor=#2E7D32;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1655.0" y="358.0" width="230.0" height="46.0" as="geometry"/></mxCell><mxCell id="p14_b264" value="&lt;b&gt;Benefit&lt;/b&gt;&lt;br&gt;The skeleton (timers, order of steps) is written once in the parent." style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EBEEF2;strokeColor=#3D5A80;fontColor=#111827;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1320.0" y="445.0" width="560.0" height="51.0" as="geometry"/></mxCell><mxCell id="p14_b266" value="4.  Observer (simplified)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#1F3A5F;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="54.0" y="540.0" width="209.6" height="23.0" as="geometry"/></mxCell><mxCell id="p14_b267" value="the manager notifies the villagers when the player dies" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#6B7280;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="54.0" y="564.0" width="309.3" height="19.0" as="geometry"/></mxCell><mxCell id="p14_b268" value="Player.onDeath()&lt;br&gt;deathCount++" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E5F3F1;strokeColor=#2A9D8F;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="110.0" y="594.0" width="460.0" height="50.0" as="geometry"/></mxCell><mxCell id="p14_b269" value="EntityManager.checkPlayerDeath()&lt;br&gt;deathCount changed?" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#E8EBEC;strokeColor=#455A64;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="110.0" y="662.0" width="460.0" height="50.0" as="geometry"/></mxCell><mxCell id="p14_b270" value="Villager.onPlayerDied(player)&lt;br&gt;default: does nothing" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EDE9F2;strokeColor=#6A4C93;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="110.0" y="730.0" width="460.0" height="50.0" as="geometry"/></mxCell><mxCell id="p14_b271" value="OldTanyo.onPlayerDied(player)&lt;br&gt;recentDeaths++ (comments next talk)" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#EDE9F2;strokeColor=#6A4C93;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="110.0" y="798.0" width="460.0" height="50.0" as="geometry"/></mxCell><mxCell id="p14_b273" value="5.  Flyweight (shared state)" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#1F3A5F;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="684.0" y="540.0" width="239.2" height="23.0" as="geometry"/></mxCell><mxCell id="p14_b274" value="static SpriteSet loaded once for ALL carabaos" style="rounded=0;arcSize=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontColor=#6B7280;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=2;spacingRight=2;strokeWidth=1.3;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="684.0" y="564.0" width="254.8" height="19.0" as="geometry"/></mxCell><mxCell id="p14_b275" value="Carabao #1" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5EDE0;strokeColor=#B26A00;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="700.0" y="608.0" width="190.0" height="44.0" as="geometry"/></mxCell><mxCell id="p14_b276" value="Carabao #2" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5EDE0;strokeColor=#B26A00;fontColor=#1F2937;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=7;spacingRight=7;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="700.0" y="678.0" width="190.0" height="44.0" as="geometry"/></mxCell><mxCell id="p14_b277" value="Carabao #3" style="rounded=1;arcSize=18;whiteSpace=nowrap;html=1;fillColor=#F5EDE0;strokeColor=#B26A